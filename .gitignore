# stateful markdown, never committed
.smd/
*.smd

# assistant/session files, never committed
.claude/
CLAUDE.md

# macOS
.DS_Store

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
.coverage.*
coverage.json
coverage.sources.json
.mypy_cache/
.ruff_cache/

# spec store written by running the examples/tests locally; mathema's
# verified records for its own functions are the exception and are
# committed (.mathema/.gitignore keeps the regenerated subdirs out)
.mathema/*
!.mathema/.gitignore
!.mathema/verified/
.mathema/verified/*
!.mathema/verified/mathema.*.yaml

# mkdocs build output (generated by `mkdocs build`, not source)
site/
# the mathema-language docs a site build imports (docs_hooks/language_reference.py)
_external/
design/

# output the runnable cdd_workflow example writes beside itself
examples/walkthrough/
